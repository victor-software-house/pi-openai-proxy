{
  "name": "@victor-software-house/pi-openai-proxy",
  "version": "4.9.6",
  "description": "OpenAI-compatible HTTP proxy for pi's multi-provider model registry",
  "license": "MIT",
  "author": "Victor Software House",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-software-house/pi-openai-proxy.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "keywords": [
    "openai",
    "proxy",
    "pi-coding-agent",
    "pi-package",
    "llm",
    "gateway"
  ],
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.1.1",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./config": {
      "import": "./dist/config.mjs",
      "types": "./dist/config.d.mts"
    },
    "./exposure": {
      "import": "./dist/exposure.mjs",
      "types": "./dist/exposure.d.mts"
    },
    "./sync/zed": {
      "import": "./dist/sync-zed.mjs",
      "types": "./dist/sync-zed.d.mts"
    }
  },
  "main": "dist/index.mjs",
  "bin": {
    "pi-openai-proxy": "dist/index.mjs"
  },
  "files": [
    "dist",
    "extensions"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "tsdown",
    "start": "bun dist/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:biome && pnpm run lint:oxlint",
    "lint:biome": "biome check .",
    "lint:oxlint": "oxlint --import-plugin --type-aware --tsconfig=./tsconfig.json .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "bun test",
    "test:ci": "bun test test/unit/ test/integration/",
    "prepare": "tsdown",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.84.3",
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "citty": "^0.2.2",
    "hono": "^4.12.18",
    "jsonc-parser": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@limegrass/eslint-plugin-import-alias": "^1.6.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/npm": "^13.1.5",
    "@types/bun": "^1.3.13",
    "@types/node": "^25.6.0",
    "eslint-plugin-zod": "^3.12.0",
    "lefthook": "^2.1.6",
    "openai": "^6.36.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "semantic-release": "^25.0.3",
    "tsdown": "^0.21.10",
    "typebox": "^1.1.38",
    "typescript": "^6.0.3"
  }
}
